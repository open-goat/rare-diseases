{
  "silo": "raredx",
  "name": "unit row",
  "description": "One unit row as the desk serves it, validated against this file. A row is closed: common plus its kind's fields, nothing else. Offsets are UTF-8 bytes; mention offsets are relative to the passage.",
  "common": {
    "type": "object",
    "required": [
      "id",
      "title",
      "kind",
      "verifier",
      "k",
      "parallel",
      "weight",
      "level",
      "points",
      "notice"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^U-[0-9a-f]{16}$"
      },
      "title": {
        "type": "string",
        "maxLength": 200
      },
      "kind": {
        "type": "string",
        "enum": [
          "extract",
          "link",
          "review",
          "hypothesize"
        ]
      },
      "verifier": {
        "type": "string",
        "pattern": "^[a-z]+\\.v[0-9]{1,4}$"
      },
      "k": {
        "type": "integer",
        "minimum": 1,
        "maximum": 7
      },
      "parallel": {
        "type": "integer",
        "minimum": 1,
        "maximum": 7
      },
      "weight": {
        "type": "integer",
        "minimum": 2,
        "maximum": 1000,
        "description": "1 or less is a unit that was stood down: the desk never offers it"
      },
      "level": {
        "type": "integer",
        "minimum": 1,
        "maximum": 4
      },
      "points": {
        "type": "integer",
        "minimum": 0,
        "maximum": 10000
      },
      "notice": {
        "type": "string",
        "maxLength": 400
      }
    }
  },
  "kinds": {
    "extract": {
      "type": "object",
      "required": [
        "source",
        "source_sha256",
        "passage",
        "passage_sha256",
        "stakes"
      ],
      "properties": {
        "source": {
          "type": "string",
          "pattern": "^source:[A-Za-z0-9_-]{4,64}$"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "passage": {
          "type": "object",
          "required": [
            "start",
            "end"
          ],
          "properties": {
            "start": {
              "type": "integer",
              "minimum": 0
            },
            "end": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "passage_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "sha256 of the exact passage bytes; the desk serves the passage by it"
        },
        "stakes": {
          "type": "string",
          "enum": [
            "low",
            "normal",
            "high"
          ]
        }
      }
    },
    "link": {
      "type": "object",
      "required": [
        "source",
        "source_sha256",
        "passage",
        "passage_sha256",
        "mention",
        "expect"
      ],
      "properties": {
        "source": {
          "type": "string",
          "pattern": "^source:[A-Za-z0-9_-]{4,64}$"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "passage": {
          "type": "object",
          "required": [
            "start",
            "end"
          ],
          "properties": {
            "start": {
              "type": "integer",
              "minimum": 0
            },
            "end": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "passage_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "mention": {
          "type": "object",
          "required": [
            "start",
            "end"
          ],
          "properties": {
            "start": {
              "type": "integer",
              "minimum": 0
            },
            "end": {
              "type": "integer",
              "minimum": 1
            }
          },
          "description": "byte offsets relative to the passage"
        },
        "expect": {
          "type": "string",
          "enum": [
            "disease",
            "drug",
            "target",
            "pathway",
            "phenotype"
          ]
        }
      }
    },
    "review": {
      "type": "object",
      "required": [
        "source",
        "source_sha256",
        "passage",
        "passage_sha256",
        "unit",
        "results"
      ],
      "properties": {
        "source": {
          "type": "string",
          "pattern": "^source:[A-Za-z0-9_-]{4,64}$"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "passage": {
          "type": "object",
          "required": [
            "start",
            "end"
          ],
          "properties": {
            "start": {
              "type": "integer",
              "minimum": 0
            },
            "end": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "passage_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "sha256 of the exact passage bytes; the desk serves the passage by it"
        },
        "unit": {
          "type": "string",
          "pattern": "^U-[0-9a-f]{16}$",
          "description": "the EXTRACT unit whose results are reviewed"
        },
        "results": {
          "type": "object",
          "required": [
            "a",
            "b"
          ],
          "properties": {
            "a": {
              "type": "object",
              "properties": {},
              "description": "an EXTRACT answer exactly as unit.extract.json answer names it (the desk checks it against that schema, quotes against the passage, and refuses free text); minted by the engine job, shown under the neutral label"
            },
            "b": {
              "type": "object",
              "properties": {},
              "description": "an EXTRACT answer exactly as unit.extract.json answer names it (the desk checks it against that schema, quotes against the passage, and refuses free text); minted by the engine job, shown under the neutral label"
            }
          },
          "description": "the two results shown side by side"
        }
      }
    },
    "hypothesize": {
      "type": "object",
      "required": [
        "disease",
        "rule",
        "evidence"
      ],
      "properties": {
        "disease": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9]*[:_][A-Za-z0-9_.-]{1,40}$",
          "x-link": [
            "MONDO",
            "ORPHA"
          ]
        },
        "rule": {
          "type": "string",
          "pattern": "^rank\\.v[0-9]{1,4}$"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "string",
            "pattern": "^E-[0-9a-f]{8,16}$"
          },
          "description": "every id must be agreed evidence"
        }
      }
    }
  }
}
