{
  "name": "target",
  "silo": "raredx",
  "schema": {
    "type": "object",
    "required": [
      "id",
      "label"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9]*[:_][A-Za-z0-9_.-]{1,40}$",
        "x-link": [
          "HGNC",
          "UNIPROT",
          "ENSEMBL"
        ]
      },
      "label": {
        "type": "string",
        "maxLength": 200
      }
    }
  },
  "statuses": {
    "open": "start",
    "linked": "verified",
    "retired": "final"
  },
  "verifier": {
    "tier": 1,
    "name": "link.v1",
    "params": {
      "ontologies": [
        "HGNC",
        "UNIPROT",
        "ENSEMBL"
      ],
      "release": "pinned at first fetch: version and sha256 (data/pins.json)"
    }
  },
  "unit_kinds": [
    "link"
  ],
  "public": true,
  "creditable": true,
  "relations": [
    "normalizes_to",
    "twin_of",
    "child_of"
  ]
}
