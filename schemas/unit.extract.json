{
  "silo": "raredx",
  "name": "extract",
  "produces": "evidence",
  "tier": 2,
  "verifier": "agreement.v1",
  "creditable": true,
  "points_base": 3,
  "inputs": "the desk row: row.unit.json kinds.extract",
  "answer": {
    "type": "object",
    "required": [
      "claims"
    ],
    "properties": {
      "claims": {
        "type": "array",
        "maxItems": 12,
        "items": {
          "type": "object",
          "description": "optional fields: an optional field alone does not prevent an otherwise valid close; one that readers do not agree on is left out of the recorded claim, and the claim still needs the required agreement and a cited span from an answer that agrees with it",
          "required": [
            "subject",
            "relation",
            "object",
            "effect",
            "organism",
            "study",
            "spans"
          ],
          "properties": {
            "subject": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9]*[:_][A-Za-z0-9_.-]{1,40}$",
              "x-link": [
                "CHEMBL",
                "DRUGCENTRAL",
                "UNII",
                "RXCUI",
                "HGNC",
                "UNIPROT",
                "ENSEMBL"
              ]
            },
            "relation": {
              "type": "string",
              "enum": [
                "inhibits",
                "activates",
                "binds",
                "modulates",
                "treats",
                "associated_with",
                "causes"
              ]
            },
            "object": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9]*[:_][A-Za-z0-9_.-]{1,40}$",
              "x-link": [
                "HGNC",
                "UNIPROT",
                "ENSEMBL",
                "REACTOME",
                "GO",
                "MONDO",
                "ORPHA",
                "HP"
              ]
            },
            "effect": {
              "type": "string",
              "enum": [
                "positive",
                "negative",
                "null",
                "unclear"
              ],
              "description": "positive: the passage supports the relation; negative: it reports the opposite; null: no significant effect; unclear"
            },
            "organism": {
              "type": "string",
              "enum": [
                "human",
                "mouse",
                "rat",
                "zebrafish",
                "fly",
                "worm",
                "yeast",
                "cell_line",
                "in_silico",
                "other"
              ],
              "description": "organism is the organism the reported finding is about; a background statement takes the organism of the paper's own subjects"
            },
            "study": {
              "type": "string",
              "enum": [
                "rct",
                "cohort",
                "case_control",
                "case_series",
                "case_report",
                "animal",
                "in_vitro",
                "in_silico",
                "review",
                "other"
              ],
              "description": "study is the design of the study that reports the claim; a background statement in a paper takes the paper's own design"
            },
            "n_subjects": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000000,
              "description": "the number of subjects in the study that reports the claim, only when the passage states it; leave it out otherwise"
            },
            "potency": {
              "type": "object",
              "x-unit": "concentration",
              "x-tol": 0.05,
              "description": "an IC50 / EC50 / Kd as reported; never a dose"
            },
            "note": {
              "type": "string",
              "maxLength": 400,
              "x-free": true,
              "description": "one short finding in plain words; held only inside the agreement engine, never shown raw or streamed"
            },
            "spans": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": {
                "type": "object",
                "required": [
                  "start",
                  "end",
                  "quote"
                ],
                "properties": {
                  "start": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "UTF-8 byte offset relative to the passage pinned by passage_sha256"
                  },
                  "end": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "quote": {
                    "type": "string",
                    "maxLength": 400,
                    "description": "the exact source bytes between start and end"
                  }
                }
              },
              "x-spans": true
            }
          }
        },
        "x-key": [
          "subject",
          "object"
        ]
      }
    }
  },
  "k": "adaptive: 2 by default",
  "relations": [
    "extracts",
    "supports",
    "refutes",
    "cites"
  ]
}
